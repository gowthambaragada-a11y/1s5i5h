# Base URL of the NETGUARD-AI FastAPI backend.
# During local development you can leave this empty ("") because vite.config.ts
# proxies /api to http://localhost:8000. Set an absolute URL for deployments
# where the API is served from another host.
VITE_API_BASE_URL=http://localhost:8000

# Milliseconds before an in-flight API request is aborted.
VITE_API_TIMEOUT_MS=30000