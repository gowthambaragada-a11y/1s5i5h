# NETGUARD-AI -- frontend configuration.
#
# Copy to `.env.local` for local development. IMPORTANT: only variables prefixed
# with VITE_ are exposed to the browser bundle. Anything else here stays in the
# build, so never put a secret in this file -- there is no server to hold it.

# Base URL of the FastAPI backend, with NO trailing slash and NO /api/v1 suffix
# (the client appends the prefix itself).
#
#   local dev  -> leave empty: "" so the request goes to the dev server, which
#                 proxies /api to http://localhost:8000 (see vite.config.ts)
#   deployed   -> absolute URL of the hosted backend, e.g.
#                 https://netguard-ai.onrender.com
VITE_API_BASE_URL=

# Milliseconds before an in-flight API request is aborted. Uploads use their own
# longer budget; this governs reads.
VITE_API_TIMEOUT_MS=30000

# Set to "false" to remove the static-snapshot fallback entirely, so the app
# reports a backend outage instead of showing bundled sample results. Recommended
# for a live deployment, where the snapshot can never be current.
VITE_ENABLE_DEMO_FALLBACK=false

# There is deliberately no auth-URL variable: the operator signs in against
# VITE_API_BASE_URL, which is the only host this app talks to. A second variable
# for the same host would be one more thing to get out of sync.

# On a static deployment (no backend reachable) the app skips the login form and
# serves frontend/public/demo-data.json instead, because there is nothing to
# authenticate against. Upload and review controls stay disabled in that mode.