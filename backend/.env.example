# NETGUARD-AI -- backend configuration.
#
# Copy to `.env` for local development. For a hosted deployment set these as
# environment variables in the platform dashboard instead; do NOT commit the
# filled-in file.
#
# Every name is case-insensitive and maps to the matching field on
# `app.core.config.Settings`.

# ---- Application ------------------------------------------------------------
ENVIRONMENT=dev                    # dev | staging | prod
DEBUG=false
API_V1_PREFIX=/api/v1

# ---- Security ---------------------------------------------------------------
# MUST be overridden wherever ENVIRONMENT=prod; startup fails otherwise.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60

# The built-in admin/analyst/viewer accounts. Convenient locally, unsafe on a
# public URL, and startup rejects them when ENVIRONMENT=prod.
ALLOW_DEMO_ACCOUNTS=true

# ---- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_SUFFIXES=.cfg,.conf,.config,.txt,.running,.saved,.json,.xml

# ---- PostgreSQL -------------------------------------------------------------
# Optional: the API runs without it, but /dashboard, /findings, /devices and
# /remediations then return 503 rather than an empty fleet.
# Managed free tiers that work here: Neon, Supabase, Aiven.
POSTGRES_DSN=postgresql+psycopg://netguard:netguard@localhost:5432/netguard
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---- Neo4j (optional) --------------------------------------------------------
# Powers /graph/exposed-services only. Analysis is unaffected without it.
# Neo4j Aura Free is enough for a demo.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GRAPH_ENABLED=true

# ---- LLM (optional) ----------------------------------------------------------
# Off by default. When enabled without a key the pipeline uses the rule-based
# generators and records a parse warning rather than failing.
LLM_ENABLED=false
LLM_PROVIDER=mock                # anthropic | openai | ollama | mock
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0

# ---- CORS -------------------------------------------------------------------
# MUST be a JSON array. Comma-separated looks friendlier and is rejected:
# pydantic-settings JSON-decodes list fields before validators run, so
# `a,b` aborts startup with a JSONDecodeError instead of being split.
# Every frontend origin must be listed exactly -- no trailing slash, and no
# wildcard (browsers reject `*` alongside credentials).
# GitHub Pages: https://<owner>.github.io
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Analysis tuning ---------------------------------------------------------
ANOMALY_CONTAMINATION=0.05
ANOMALY_MIN_SAMPLES=25